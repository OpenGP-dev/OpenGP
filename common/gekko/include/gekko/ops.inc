//
// The Gekko instruction set (PowerPC 750CXe user + supervisor ISA, plus Gekko
// paired singles and locked-cache extensions). Everything that needs to know
// about instructions is generated from this table.
//
// GEKKO_OP(id, mnemonic, opcd, xo, kind, sig, cc, flags)
//   id        C++ identifier (trailing '_' for C++ alternative tokens, '_rc' for record-only forms)
//   mnemonic  assembler mnemonic
//   opcd      primary opcode (bits 0-5)
//   xo        extended opcode, interpreted according to kind
//   kind      PRI  primary opcode only
//             X10  10-bit XO in bits 21-30
//             X9   XO-form: 9-bit XO in bits 22-30, bit 21 is OE (both values decode)
//             X5   A-form: 5-bit XO in bits 26-30
//             X6   paired-single indexed load/store: 6-bit XO in bits 25-30
//   sig       operand signature (sigs.inc)
//   cc        how the semantic helper ppc::op::<id> is called
//             CTX     op(ctx, fields...)
//             MEM     op<Mem kind>(ctx, base, fields...)
//             BASE    op(ctx, base, fields...)
//             PC      op(ctx, base, pc, fields...)
//             BRANCH  control flow; handled by the interpreter/codegen themselves
//   flags     F_LOAD, F_STORE, F_UPD (writes EA back to rA), F_FP, F_PRIV

